{
  "info": { "name": "Student Management API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000/api" }, { "key": "studentId", "value": "1" }],
  "item": [
    { "name": "Health", "request": { "method": "GET", "url": "http://localhost:3000/health" } },
    { "name": "List students", "request": { "method": "GET", "url": "{{baseUrl}}/students?page=1&limit=10&search=" } },
    { "name": "Get student", "request": { "method": "GET", "url": "{{baseUrl}}/students/{{studentId}}" } },
    { "name": "Create student", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [ { "key": "name", "value": "Aarya Sharma", "type": "text" }, { "key": "course", "value": "BCA", "type": "text" }, { "key": "year", "value": "1", "type": "text" }, { "key": "dob", "value": "2005-05-12", "type": "text" }, { "key": "email", "value": "aarya@example.com", "type": "text" }, { "key": "mobileNumber", "value": "9876543210", "type": "text" }, { "key": "gender", "value": "Female", "type": "text" }, { "key": "address", "value": "Pune, Maharashtra", "type": "text" }, { "key": "photo", "type": "file", "src": "" } ] }, "url": "{{baseUrl}}/students" } },
    { "name": "Update student", "request": { "method": "PUT", "body": { "mode": "formdata", "formdata": [ { "key": "name", "value": "Aarya Sharma", "type": "text" }, { "key": "course", "value": "BCA", "type": "text" }, { "key": "year", "value": "2", "type": "text" }, { "key": "dob", "value": "2005-05-12", "type": "text" }, { "key": "email", "value": "aarya@example.com", "type": "text" }, { "key": "mobileNumber", "value": "9876543210", "type": "text" }, { "key": "gender", "value": "Female", "type": "text" }, { "key": "address", "value": "Pune, Maharashtra", "type": "text" } ] }, "url": "{{baseUrl}}/students/{{studentId}}" } },
    { "name": "Delete student", "request": { "method": "DELETE", "url": "{{baseUrl}}/students/{{studentId}}" } }
  ]
}
